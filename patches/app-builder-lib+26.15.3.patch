@@ -0,0 +1,50 @@
+"use strict";
+// Build-only @electron/get v5 compatibility for pinned app-builder-lib 26.15.3.
+// Proxy/retry migration follows electron-builder@27.0.0-alpha.9's electronGet.ts;
+// the browser runtime and the rest of the stable packager are unchanged.
+const { FetchDownloader, initializeProxy } = require("@electron/get");
+let proxyInitialized = false;
+
+class BuilderFetchDownloader extends FetchDownloader {
+    async download(url, target, options = {}) {
+        const { timeout, agent, https, signal, ...fetchOptions } = options;
+        if (agent != null || (https != null && Object.keys(https).some(key => key !== "rejectUnauthorized" || https[key] !== true))) {
+            throw new Error("Legacy custom download agents and insecure TLS options are unsupported; use HTTP(S)_PROXY/NO_PROXY or Fetch RequestInit options.");
+        }
+        if (!proxyInitialized) {
+            initializeProxy();
+            proxyInitialized = true;
+        }
+        const duration = timeout?.request ?? 10 * 60 * 1000;
+        if (!Number.isSafeInteger(duration) || duration <= 0 || duration > 0xffffffff) {
+            throw new Error("Artifact download timeout must be a positive integer in milliseconds.");
+        }
+        // Each attempt (and checksum request) gets a fresh full-body deadline.
+        const deadline = AbortSignal.timeout(duration);
+        try {
+            await super.download(url, target, {
+                ...fetchOptions,
+                signal: signal ? AbortSignal.any([signal, deadline]) : deadline,
+            });
+        } catch (error) {
+            if (deadline.aborted && !signal?.aborted) {
+                throw Object.assign(new Error("Artifact download timed out", { cause: error }), { code: "ETIMEDOUT" });
+            }
+            throw error;
+        }
+    }
+}
+
+function shouldRetryDownloadError(error) {
+    if (error == null || error.name === "AbortError") {
+        return false;
+    }
+    const status = error.response?.status ?? error.response?.statusCode;
+    if (typeof status === "number") {
+        return status >= 500 || status === 429;
+    }
+    const code = error.code ?? error.cause?.code;
+    return ["ENOTFOUND", "ETIMEDOUT", "ECONNRESET", "ECONNREFUSED", "EAI_AGAIN", "EPIPE", "ENOENT", "UND_ERR_SOCKET", "UND_ERR_CONNECT_TIMEOUT"].includes(code);
+}
+
+module.exports = { BuilderFetchDownloader, shouldRetryDownloadError };
