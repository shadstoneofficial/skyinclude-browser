{
  "name": "skyinclude-browser",
  "version": "0.1.26",
  "description": "Electron browser with native Handshake (HNS) domain resolution",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/apply-toolchain-patch.js",
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "build-dmg-clean": "electron-builder --mac",
    "build-windows": "electron-builder --win",
    "build-all": "electron-builder --mac --win --linux",
    "dist": "electron-builder --publish=never",
    "dist-mac": "electron-builder --mac --publish=never",
    "dist-mac-notarized": "bash scripts/build-notarized-macos.sh",
    "dist-win": "electron-builder --win --publish=never",
    "dist-linux": "electron-builder --linux --publish=never",
    "pack": "electron-builder --dir",
    "benchmark:resolver": "node scripts/benchmark-resolver.js",
    "check:toolchain": "node --check scripts/apply-toolchain-patch.js && node --check tests/helpers/toolchain-proxy-probe.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check resolver.js && node --check resolver-config.js && node --check navigation-policy.js && node --check settings.js && node --check history.js && node --check hns-tls.js && node --check profile-utils.js && node --check address-input.js && node --check async-log.js && node --check scripts/update-icann-tlds.js && node --check scripts/benchmark-resolver.js && npm run check:toolchain",
    "test": "npm run check && node --test tests/*.test.js"
  },
  "keywords": [
    "browser",
    "handshake",
    "hns",
    "decentralized",
    "web3"
  ],
  "author": "SkyInclude Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@electron/get": "5.1.0",
    "electron": "42.11.3",
    "electron-builder": "26.15.3",
    "undici": "7.30.0"
  },
  "overrides": {
    "@electron/get": "$@electron/get"
  },
  "build": {
    "appId": "com.skyinclude.browser",
    "productName": "SkyInclude Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "resolver.js",
      "resolver-config.js",
      "navigation-policy.js",
      "address-input.js",
      "async-log.js",
      "hns-tls.js",
      "profile-utils.js",
      "history.js",
      "settings.js",
      "index.html",
      "styles.css",
      "announcement.html",
      "settings-ui.html",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "maintainer": "SkyInclude Team <shadstoneofficial@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
